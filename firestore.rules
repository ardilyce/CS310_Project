rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to check if user owns the document
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    // Users collection - users can only read/write their own data
    match /users/{userId} {
      // Users can read and write their own user document
      allow read, write: if isOwner(userId);
      
      // Users can create their own user document during registration
      allow create: if isAuthenticated() && request.auth.uid == userId;

      // User inquiries subcollection
      match /inquiries/{inquiryId} {
        allow read, write: if isOwner(userId);
      }
    }
    
    // Inquiries collection - users can only access their own inquiries
    match /inquiries/{inquiryId} {
      // Users can read inquiries they created
      allow read: if isAuthenticated() && 
        (resource.data.createdBy == request.auth.uid || 
         !exists(resource.data.createdBy));
      
      // Users can create inquiries (will be linked to their user ID)
      allow create: if isAuthenticated() && 
        request.resource.data.createdBy == request.auth.uid;
      
      // Users can update their own inquiries
      allow update: if isAuthenticated() && 
        resource.data.createdBy == request.auth.uid &&
        request.resource.data.createdBy == request.auth.uid;
      
      // Users can delete their own inquiries
      allow delete: if isAuthenticated() && 
        resource.data.createdBy == request.auth.uid;
    }
    
    // Reports collection (for community reporting feature)
    match /reports/{reportId} {
      // Anyone authenticated can read reports (for community awareness)
      allow read: if isAuthenticated();
      
      // Anyone authenticated can create reports
      allow create: if isAuthenticated() && 
        request.resource.data.createdBy == request.auth.uid;
      
      // Only admins or the creator can update/delete (if you add admin role later)
      allow update, delete: if isAuthenticated() && 
        resource.data.createdBy == request.auth.uid;
    }
    
    // Deny all other access by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
